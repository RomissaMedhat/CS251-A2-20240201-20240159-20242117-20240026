<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15" styleClass="root"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.budgetapp.ui.GoalsController">
    <HBox styleClass="nav-bar">
        <Button text="%dashboard.home" onAction="#onHome" styleClass="nav-button"/>
    </HBox>
    <VBox spacing="10" style="-fx-padding: 20;">
        <Label text="%goals.title"/>
        <HBox spacing="10">
            <TextField fx:id="goalNameField" promptText="%goals.name"/>
            <TextField fx:id="targetField" promptText="%goals.target"/>
            <DatePicker fx:id="deadlinePicker" promptText="%goals.deadline"/>
            <Button text="%goals.add" onAction="#onCreateGoal" styleClass="button-primary"/>
        </HBox>
        <ListView fx:id="goalsList"/>
        <Label fx:id="statusLabel"/>
    </VBox>
</VBox>