<VBox spacing="15" styleClass="root">
    <HBox styleClass="nav-bar"> <Button text="Home" onAction="#goHome" styleClass="nav-button"/> </HBox>
    <VBox spacing="10" style="-fx-padding: 20;">
        <Label text="Savings Goals"/>
        <HBox spacing="10">
            <TextField fx:id="goalNameField" promptText="Goal Name"/>
            <TextField fx:id="targetField" promptText="Target Amount"/>
            <DatePicker fx:id="deadlinePicker"/>
            <Button text="Add Goal" onAction="#onCreateGoal" styleClass="button-primary"/>
        </HBox>
        <ListView fx:id="goalsList"/>
        <Label fx:id="statusLabel"/>
    </VBox>
</VBox>