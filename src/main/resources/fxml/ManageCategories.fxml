<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15" styleClass="root"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.budgetapp.ui.ManageCategoriesController">
    <HBox styleClass="nav-bar">
        <Button text="%dashboard.home" onAction="#onHome" styleClass="nav-button"/>
    </HBox>
    <VBox spacing="10" style="-fx-padding: 20;">
        <Label text="%categories.title"/>
        <HBox spacing="10">
            <TextField fx:id="newCategoryName" promptText="%categories.new"/>
            <Button text="%categories.add" onAction="#onAddCategory" styleClass="button-primary"/>
        </HBox>
        <ListView fx:id="categoryList"/>
        <HBox spacing="10">
            <Button text="%categories.edit" onAction="#onEditCategory" styleClass="button-secondary"/>
            <Button text="%categories.delete" onAction="#onDeleteCategory" styleClass="button-secondary"/>
        </HBox>
        <Label fx:id="statusLabel"/>
    </VBox>
</VBox>