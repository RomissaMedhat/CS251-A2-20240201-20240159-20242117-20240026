<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15" styleClass="root"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.budgetapp.ui.DashboardController">

    <HBox styleClass="nav-bar" spacing="10">
        <Button text="%dashboard.home" onAction="#onHome" styleClass="nav-button"/>
        <Button text="%dashboard.addTransaction" onAction="#onAddTransaction" styleClass="nav-button"/>
        <Button text="%dashboard.budgets" onAction="#onBudgets" styleClass="nav-button"/>
        <Button text="%dashboard.goals" onAction="#onGoals" styleClass="nav-button"/>
        <Button text="%dashboard.reports" onAction="#onReports" styleClass="nav-button"/>
        <Button text="%dashboard.profile" onAction="#onProfile" styleClass="nav-button"/>
        <Button text="%dashboard.history" onAction="#onHistory" styleClass="nav-button"/>
        <Button text="%dashboard.notifications" onAction="#onNotifications" styleClass="nav-button"/>
        <Button text="%dashboard.export" onAction="#onExport" styleClass="nav-button"/>
        <Button text="%dashboard.categories" onAction="#onManageCategories" styleClass="nav-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%dashboard.logout" onAction="#onLogout" styleClass="nav-button"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background: #f6eff7; -fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 20;">

            <Label text="%dashboard.title" styleClass="bubble-text-sm" />

            <VBox styleClass="card" spacing="10">
                <Label text="%dashboard.balance" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                <Label fx:id="balanceLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <Label text="%dashboard.income"/><Label fx:id="monthlyIncomeLabel" styleClass="income-text"/>
                    <Label text="%dashboard.expense"/><Label fx:id="monthlyExpenseLabel" styleClass="expense-text"/>
                </HBox>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="%dashboard.recent" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <ListView fx:id="recentTransactionsList" prefHeight="150"/>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="%dashboard.alerts" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <ListView fx:id="alertsList" prefHeight="100"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>