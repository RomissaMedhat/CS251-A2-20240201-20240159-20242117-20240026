<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="15" styleClass="root"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.budgetapp.ui.ReportsController">
    <HBox styleClass="nav-bar">
        <Button text="%dashboard.home" onAction="#onHome" styleClass="nav-button"/>
    </HBox>
    <VBox spacing="10" style="-fx-padding: 20;">
        <HBox spacing="10">
            <DatePicker fx:id="startDate"/>
            <DatePicker fx:id="endDate"/>
            <Button text="%reports.generate" onAction="#onGenerate" styleClass="button-primary"/>
        </HBox>
        <StackPane fx:id="chartContainer"/>
    </VBox>
</VBox>