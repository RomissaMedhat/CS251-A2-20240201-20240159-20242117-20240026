<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="20" styleClass="root" xmlns="http://javafx.com/javafx/17">
    <Label text="Personal Budgeting App" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <VBox spacing="15" styleClass="card" maxWidth="300">
        <TextField fx:id="emailField" promptText="Email"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
        <Button text="Login" onAction="#onLogin" styleClass="button-primary"/>
        <Button text="Create Account" onAction="#onRegister"/>
        <Label fx:id="errorLabel" styleClass="alert-text"/>
    </VBox>
</VBox>